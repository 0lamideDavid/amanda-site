# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL connection string used by Prisma and the session store)
DATABASE_URL=postgresql://user:password@localhost:5432/amandas_dev

# Session
SESSION_SECRET=replace-with-a-long-random-value

# Initial admin seed (used only by the seed script; change after first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
