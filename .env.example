# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL connection string used by Prisma and the session store)
DATABASE_URL=postgresql://user:password@localhost:5432/amandas_dev

# Session
SESSION_SECRET=replace-with-a-long-random-value

# Initial admin seed (used only by the seed script; change after first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Email notifications (Resend). All optional — if RESEND_API_KEY or
# EMAIL_FROM is unset, email sending is skipped (logged, not an error).
RESEND_API_KEY=
EMAIL_FROM=Amanda's <hello@example.com>
# Where "new booking request" alerts go. Defaults to SEED_ADMIN_EMAIL if unset.
ADMIN_NOTIFICATION_EMAIL=
# Used to build absolute links in emails (e.g. "View in admin"). Set to the
# real deployed URL in production.
APP_BASE_URL=http://localhost:3000
