<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin login | Amanda's</title>
  <script>
    (function () {
      var saved = localStorage.getItem("amandas-theme");
      if (saved === "dark" || saved === "light") document.documentElement.setAttribute("data-theme", saved);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="brand-name">Amanda's admin</span>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">&#9789;</button>
      </div>
      <h1>Admin login</h1>
      <p class="lede">Sign in to manage bookings, services, customers and complaints.</p>
      <% if (error) { %>
        <p class="error" role="alert"><%= error %></p>
      <% } %>
      <form method="POST" action="/admin/login">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required>
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button class="btn btn-accent full-width" type="submit">Log in</button>
      </form>
    </div>
  </div>
  <script src="/js/admin.js?v=<%= assetVersion %>"></script>
</body>
</html>
