<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Admin overview</title>
</head>
<body>
  <%- include('_nav') %>
  <main>
    <h1>Overview</h1>

    <div class="stat-cards">
      <a class="stat-card" href="/admin/bookings?status=PENDING">
        <div class="stat-value"><%= pendingCount %></div>
        <div class="stat-label">Pending request<%= pendingCount === 1 ? '' : 's' %> awaiting review</div>
      </a>
      <a class="stat-card" href="/admin/calendar">
        <div class="stat-value"><%= upcomingConfirmedCount %></div>
        <div class="stat-label">Upcoming confirmed appointment<%= upcomingConfirmedCount === 1 ? '' : 's' %></div>
      </a>
      <a class="stat-card" href="/admin/complaints">
        <div class="stat-value"><%= openComplaintsCount %></div>
        <div class="stat-label">Open complaint<%= openComplaintsCount === 1 ? '' : 's' %></div>
      </a>
    </div>

    <h2>Pending requests</h2>
    <% if (pendingRequests.length === 0) { %>
      <p>No pending requests.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Requested date</th><th>Service</th><th>Customer</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% pendingRequests.forEach(function (b) { %>
            <tr>
              <td><%= b.requestedDate.toISOString().slice(0, 10) %> (<%= b.requestedTime %>)</td>
              <td><%= b.service.name %></td>
              <td><%= b.customer.name %></td>
              <td><span class="badge badge-<%= b.status %>"><%= b.status %></span></td>
              <td><a href="/admin/bookings/<%= b.id %>">Review</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
