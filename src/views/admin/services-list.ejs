<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Services</title>
</head>
<body>
  <%- include('_nav') %>
  <main>
    <h1>Services</h1>
    <p><a href="/admin/services/new">Add a new service</a></p>
    <div class="table-wrap"><table>
      <thead><tr><th>Name</th><th>Pricing</th><th>Base price</th><th>Minimum</th><th>Active</th><th></th></tr></thead>
      <tbody>
        <% services.forEach(function (s) { %>
          <tr>
            <td><%= s.name %></td>
            <td><%= s.pricingUnit %></td>
            <td><%= s.basePrice !== null ? ('£' + s.basePrice.toString()) : '—' %></td>
            <td><%= s.minimum !== null ? s.minimum.toString() : '—' %></td>
            <td><%= s.active ? 'Yes' : 'No' %></td>
            <td><a href="/admin/services/<%= s.id %>/edit">Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  </main>
</body>
</html>
