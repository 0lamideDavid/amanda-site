<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title><%= title %></title>
</head>
<body style="margin:0;padding:0;background-color:#f5f3eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <!-- Preview text shown in inbox lists, hidden in the body -->
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;"><%= preheader %></div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f5f3eb;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
          <tr>
            <td style="padding-bottom:24px;text-align:center;">
              <span style="font-size:20px;font-weight:700;color:#12271c;">Amanda&rsquo;s</span>
            </td>
          </tr>
          <tr>
            <td style="background-color:#ffffff;border:1px solid #e9f0d9;border-radius:20px;padding:36px;">
              <p style="margin:0 0 12px;text-transform:uppercase;letter-spacing:0.08em;font-size:12px;font-weight:600;color:#4e7a5f;"><%= eyebrow %></p>
              <h1 style="margin:0 0 16px;font-size:24px;line-height:1.3;color:#12271c;font-weight:700;"><%= title %></h1>
              <div style="font-size:15px;line-height:1.6;color:#5c7264;">
                <%- introHtml %>
              </div>

              <% if (detailRows && detailRows.length) { %>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:24px 0;background-color:#eceadf;border-radius:12px;">
                <% detailRows.forEach(function (row, i) { %>
                <tr>
                  <td style="padding:12px 16px;<% if (i > 0) { %>border-top:1px solid #ffffff;<% } %>font-size:13px;color:#5c7264;font-weight:600;white-space:nowrap;vertical-align:top;">
                    <%= row.label %>
                  </td>
                  <td style="padding:12px 16px;<% if (i > 0) { %>border-top:1px solid #ffffff;<% } %>font-size:14px;color:#12271c;text-align:right;">
                    <%= row.value %>
                  </td>
                </tr>
                <% }) %>
              </table>
              <% } %>

              <% if (outroHtml) { %>
              <div style="font-size:15px;line-height:1.6;color:#5c7264;margin-top:4px;">
                <%- outroHtml %>
              </div>
              <% } %>

              <% if (ctaText && ctaUrl) { %>
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:28px;">
                <tr>
                  <td style="border-radius:999px;background-color:#e1fcad;">
                    <a href="<%= ctaUrl %>" style="display:inline-block;padding:13px 28px;font-size:15px;font-weight:600;color:#12271c;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                      <%= ctaText %>
                    </a>
                  </td>
                </tr>
              </table>
              <% } %>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 12px 0;text-align:center;font-size:12px;line-height:1.6;color:#5c7264;">
              <p style="margin:0 0 4px;"><%= contact.brand %> &middot; <%= contact.tagline %> &middot; <%= contact.area %></p>
              <p style="margin:0;">
                <a href="mailto:<%= contact.email %>" style="color:#4e7a5f;text-decoration:underline;"><%= contact.email %></a>
                &middot; <%= contact.phone %>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
